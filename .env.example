# 从项目根目录复制为 .env。主程序从环境变量或本地 .env 读取；环境变量优先。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=smartserve
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
SESSION_SIGNING_SECRET=replace-with-at-least-32-random-characters
MCP_SERVICE_TOKEN=replace-with-a-private-random-service-token
# true 允许演示角色切换；对外部署必须关闭并设置下面两项，或接入真实身份认证。
DEMO_ACCESS=true
CUSTOMER_API_TOKEN=
ADMIN_API_TOKEN=
EMBEDDINGS_ENABLED=true
# 在 backend/ 下运行时使用 ../data。Docker Compose 自动覆盖为 /app/data。
SMARTSERVE_DATA_PATH=../data
SERVER_PORT=8080
DB_USER=smartserve
DB_PASSWORD=smartserve-local
# postgres配置在Windows上默认连接项目容器：PG 15432、Redis 16379。
# postgres-local仍连接本机PG 5432；完整Docker运行会自动使用容器内部地址和端口。
REDIS_PASSWORD=smartserve-local
RABBIT_USER=smartserve
RABBIT_PASSWORD=smartserve-local

SPRING_PROFILES_ACTIVE=demo

# 可选：指定较新的 Maven 可执行文件，留空则使用 PATH。
MAVEN_EXECUTABLE=
