# Never commit .env. Run scripts/init-env.ps1 once to generate local account/service secrets.
SPRING_PROFILES_ACTIVE=demo
LLM_API_KEY=
LLM_BASE_URL=https://tokendance.space/gateway/v1
LLM_MODEL=deepseek-v4.1-flash
LLM_PROVIDER=tokendance
LLM_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=smartserve-v2
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_CUSTOMER_PASSWORD=
SESSION_SIGNING_SECRET=
MCP_SERVICE_TOKEN=
SESSION_HOURS=12
SECURE_COOKIE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

EMBEDDINGS_ENABLED=true
SMARTSERVE_DATA_PATH=../data
SERVER_PORT=8080
AGENT_MAX_TURNS=5
AGENT_MAX_CALLS=10
MODEL_TIMEOUT_SECONDS=45
MODEL_MAX_TOKENS=4096
MODEL_RETRIES=1
RUN_QUEUE=smartserve.runs

# For native PostgreSQL use profile postgres-local, DB_USER=postgres and your own password.
# Docker Compose uses these credentials for its independent PostgreSQL/Redis/RabbitMQ.
# Existing Docker volumes keep their original PostgreSQL/RabbitMQ credentials.
DB_USER=smartserve
DB_PASSWORD=smartserve-local
REDIS_PASSWORD=smartserve-local
RABBIT_USER=smartserve
RABBIT_PASSWORD=smartserve-local
MAVEN_EXECUTABLE=
